# ============================================================
# KEYS REQUIRED — get these from Supabase Dashboard
# Project Settings → API
# ============================================================

# REQUIRED — Project URL (looks like https://xxxxx.supabase.co)
SUPABASE_URL=PASTE_YOUR_SUPABASE_URL_HERE

# REQUIRED — anon / public key (safe for the mobile app)
SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE

# ============================================================
# Backend API — REQUIRED for App Store / Play Store / real phones
# ============================================================
# Public HTTPS URL of your deployed Express API (no trailing slash).
# Without this, the app calls localhost / 10.0.2.2 and the dashboard
# will never load on a published APK/IPA.
#
# Examples:
#   API_BASE_URL=https://api.yourdomain.com
#   API_BASE_URL=https://your-app.onrender.com
API_BASE_URL=PASTE_YOUR_PUBLIC_BACKEND_URL_HERE
