PORT=3000
NODE_ENV=development

# ============================================================
# KEYS REQUIRED — Supabase → Project Settings → API
# ============================================================
SUPABASE_URL=PASTE_YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ============================================================
# TMDB — mood-based entertainment recommendations
# https://developer.themoviedb.org/docs
# ============================================================
TMDB_API_KEY=PASTE_YOUR_TMDB_API_KEY_HERE

# ============================================================
# USDA FoodData Central — meal calorie lookup
# https://fdc.nal.usda.gov/api-key-signup
# ============================================================
USDA_FDC_API_KEY=PASTE_YOUR_USDA_FDC_API_KEY_HERE

# ============================================================
# AI — required for AI Daily Brief + Insights (OpenAI)
# ============================================================
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Mailtrap — https://mailtrap.io/home
# Prefer API token (Settings → API Tokens)
# ============================================================
MAILTRAP_API_TOKEN=PASTE_YOUR_MAILTRAP_API_TOKEN

# Sandbox testing (Email Testing inbox) — recommended while developing
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=PASTE_INBOX_ID

# From address (sandbox can use Mailtrap demo sender)
MAIL_FROM=Harmonious <hello@demomailtrap.com>

# Optional SMTP fallback (Email Testing → SMTP Settings)
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USER=
# MAILTRAP_PASS=
